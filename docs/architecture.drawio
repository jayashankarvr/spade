ance.py&lt;br&gt;which images share regions&lt;br&gt;(graph, JSON / DOT, FDR)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="840" y="650" width="260" height="80" as="geometry"/></mxCell><mxCell id="arch-26" value="Benchmark harness (bench/)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1140" y="620" width="520" height="120" as="geometry"/></mxCell><mxCell id="arch-27" value="datasets: synthetic · photos · CASIA v2 · COVERAGE · CoMoFoD · manifest&lt;br&gt;download (Kaggle) · calibration (false regions vs NFA) · runner · RootSIFT baseline" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1160" y="650" width="480" height="80" as="geometry"/></mxCell><mxCell id="arch-28" value="External: image files (donors / questioned) · FAISS · NumPy / SciPy / Pillow · Kaggle datasets · &lt;i&gt;planned: pdqhash, imagehash, libpHash (user-installed, GPLv3), Microsoft PhotoDNA (licensed key)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="1640" height="60" as="geometry"/></mxCell><mxCell id="arch-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="arch-3" target="arch-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="arch-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="arch-4" target="arch-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="arch-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="arch-5" target="arch-8"><mxGeometry relative="1" as="geometry"/></m