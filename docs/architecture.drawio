="1640" height="330" as="geometry"/></mxCell><mxCell id="flow-16" value="Questioned image" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="245" width="190" height="80" as="geometry"/></mxCell><mxCell id="flow-17" value="Search passes (run on threads)&lt;br&gt;default: as given&lt;br&gt;thorough: + mirrored, + shrunk 3/4, 1/2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="250" y="245" width="260" height="80" as="geometry"/></mxCell><mxCell id="flow-18" value="Extract + describe&lt;br&gt;source patches" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="530" y="245" width="190" height="80" as="geometry"/></mxCell><mxCell id="flow-19" value="k nearest neighbours&lt;br&gt;(FAISS, k = 8)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="740" y="245" width="190" height="80" as="geometry"/></mxCell><mxCell id="flow-20" value="Per-patch pre-filter&lt;br&gt;grey gain/offset fit, chi-square&lt;br&gt;(clipped pixels ignored)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="950" y="245" width="230" height="80" as="geometry"/></mxCell><mxCell id="flow-21" value="Cluster by offset&lt;br&gt;per target and scale&lt;br&gt;(rigid transform in rotation mode)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1200" y="245" width="220" height="80" as="geometry"/></mxCell><mxCell id="flow-22" value="Split into connected parts&lt;br&gt;(cross-image search)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1440" y="245" width="200" height="80" as="geometry"/></mxCell><mxCell id="flow-23" value="Region colour fit&lt;br&gt;one 3x3 transform,&lt;br&gt;keep consistent patches" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1440" y="345" width="200" height="80" as="geometry"/></mxCell><mxCell id="flow-24" value="NFA = tests × P[Binomial(n, p) ≥ k]&lt;br&gt;tests: offsets × positions ×&lt;br&gt;region sizes × scales × passes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1180" y="345" width="240" height="80" as="geometry"/></mxCell><mxCell id="flow-25" value="Merge passes&lt;br&gt;map coords back, NFA × passes,&lt;br&gt;drop duplicate regions" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="930" y="345" width="230" height="80" as="geometry"/></mxCell><mxCell id="flow-26" value="thorough: + rotation search&lt;br&gt;(rings, angle by ring alignment)&lt;br&gt;NFA × number of searches" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="660" y="345" width="250" height="80" as="geometry"/></mxCell><mxCell id="flow-27" value="Significant regions (NFA &amp;lt; max_nfa)&lt;br&gt;colour transform, localization,&lt;br&gt;heatmap" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="400" y="345" width="240" height="80" as="geometry"/></mxCell><mxCell id="flow-28" value="Reports&lt;br&gt;JSON forensic report (versioned, SHA-256)&lt;br&gt;HTML report · CLI summary · REST response" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="345" width="340" height="80" as="geometry"/></mxCell><mxCell id="flow-29" value="Why the NFA: a region is reported only if that many agreeing patches would be expected by chance less than max_nfa times across every hypothesis tried. Benchmarks check it directly (false regions per pair ≤ threshold): 0 false regions on 120+ unrelated photo pairs and on CASIA unrelated pairs." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f9f9f9;strokeColor=#999999;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="1600" height="85" as="geometry"/></mxCell><mxCell id="flow-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="flow-16" target="flow-17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="flow-17" target="flow-18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="flow-18" target="flow-19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="flow-19" target="flow-20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="flow-20" target="flow-21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="flow-21" target="flow-22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="flow-22" target="flow-23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="flow-23" target="flow-24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="flow-24" target="flow-25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="flow-25" target="flow-26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="flow-26" target="flow-27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="flow-27" target="flow-28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-42" value="3. Copy-move within one image (match_self)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="810" height="260" as="geometry"/></mxCell><mxCell id="flow-43" value="Index the image&lt;br&gt;against itself" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="595" width="180" height="70" as="geometry"/></mxCell><mxCell id="flow-44" value="Ignore offsets &amp;lt; 2 × patch&lt;br&gt;keep one direction&lt;br&gt;per pair" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="240" y="595" width="180" height="70" as="geometry"/></mxCell><mxCell id="flow-45" value="Ratio test: best competing&lt;br&gt;offset raises the&lt;br&gt;chance rate" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="440" y="595" width="180" height="70" as="geometry"/></mxCell><mxCell id="flow-46" value="Drop symmetric objects&lt;br&gt;(mirror halves, turning&lt;br&gt;about own centre)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="595" width="170" height="70" as="geometry"/></mxCell><mxCell id="flow-47" value="Same verification and NFA as above. Not split into connected parts (would flag objects that genuinely repeat). thorough adds mirroring only; rotated or rescaled copy-moves aren't handled yet." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f9f9f9;strokeColor=#999999;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="770" height="115" as="geometry"/></mxCell><mxCell id="flow-48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="flow-43" target="flow-44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="flow-44" target="flow-45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="flow-45" target="flow-46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-51" value="4. Collections" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="850" y="560" width="810" height="120" as="geometry"/></mxCell><mxCell id="flow-52" value="spade scan: many questioned images vs one index&lt;br&gt;Benjamini-Hochberg FDR across all regions" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="870" y="595" width="370" height="70" as="geometry"/></mxCell><mxCell id="flow-53" value="spade provenance: every image vs every other&lt;br&gt;(+ copy-moves) → link graph, JSON / DOT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1260" y="595" width="380" height="70" as="geometry"/></mxCell><mxCell id="flow-54" value="5. Image hashing (planned)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="850" y="700" width="810" height="120" as="geometry"/></mxCell><mxCell id="flow-55" value="PDQ · pHash · libpHash&lt;br&gt;(+ 8 rotations/flips with thorough)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="870" y="735" width="240" height="70" as="geometry"/></mxCell><mxCell id="flow-56" value="Compare with hash list&lt;br&gt;same algorithm only,&lt;br&gt;PDQ ≤ 31 bits, quality ≥ 50" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1130" y="735" width="240" height="70" as="geometry"/></mxCell><mxCell id="flow-57" value="PhotoDNA: licensee's key,&lt;br&gt;Microsoft Cloud Service,&lt;br&gt;only when named" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1390" y="735" width="250" height="70" as="geometry"/></mxCell><mxCell id="flow-58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="1" source="flow-55" target="flow-56"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
